\begin{frame}{Background}
\begin{block}{Equation}
    Consider the nonlinear pendulum:
  \begin{equation}\label{eq:pendulumODE}\tag{P}
      \frac{d^2\theta}{dt^2} + \sin\theta = 0, \qquad
    \theta(0) = \varepsilon,\quad \theta'(0) = 0, \qquad \varepsilon \ll 1. 
  \end{equation}
\end{block}
 
  
  \medskip
  \begin{itemize}
      \item By conservation of energy, the oscillation is small. i.e.
        \[\theta(t)=O(\epsilon)\]
        
      \item Construct a perturbation series that is uniformly
        valid for all $t$ and small $\varepsilon$, by accounting for
        the slow phase drift caused by nonlinearity.
       
      \medskip
      \item Try pertubation series
        \begin{equation}
            \theta(t)\sim\epsilon\theta_0(t) 
            \tag{1}
        \end{equation}
        subject to $\theta_0(0)=1, \theta_0'(0)=0$.
    \end{itemize}
  
\end{frame}

\begin{frame}{Background (continued)}
    \begin{itemize}
        \item Plugging into (\ref{eq:pendulumODE}) gives
        \newline
        \begin{align}
            \epsilon\theta_0''+\sin(\epsilon\theta_0) = 0 \tag{2}\\
            \theta_0''+\frac{\sin(\epsilon\theta_0)}{\epsilon} = 0
            \tag{3}
        \end{align}
        
        \medskip
        \item Expanding $\sin(\epsilon\theta_0)$ in Taylor series gives 
        \begin{equation}
            \theta_0''+\theta_0-\frac{\epsilon^2}{6}\theta_0^3 + ... = 0
        \tag{4}
        \end{equation}
        which is the same as the weakly non-linear Duffing equation.
        
        \medskip
        \item We know from part 1 that (4) results in a secular term that is not valid for $t=O(\epsilon^{-2})$, hence we need to introduce new timescales 
        
    \end{itemize}
\end{frame}


% ──────────────────────────────────────────────────────────────
\section{The Method of Multiple Scales}
% ──────────────────────────────────────────────────────────────


\begin{frame}{Setup}
    \begin{itemize}
        \item Introduce two independent time variables capturing fast and slow dynamics:
            \[
              t_0 = t \qquad \text{(fast)}, \qquad t_1 = \varepsilon^2 t \qquad \text{(slow)}.
            \]
        \medskip
        \item Treat $\theta$ as a function of both, and expand:
            \[
              \theta(t) = \varepsilon\,\theta_0(t_0, t_1)
                      + \varepsilon^3\theta_1(t_0, t_1) + \cdots
            \]

      \medskip
      \item chain rule applies for partial derivative on(P):
      \begin{align}
        \frac{d}{dt}   &= \frac{\partial}{\partial t_0} + \varepsilon^2\,\frac{\partial}{\partial t_1},
        \tag{5} \\[4pt]
        \frac{d^2}{dt^2} &= \frac{\partial^2}{\partial t_0^2}
                         + 2\varepsilon^2\,\frac{\partial^2}{\partial {t_0 t_1}} + O(\epsilon^4)
        \tag{6}
      \end{align}

      \medskip
      \item The apparent redundancy of two time variables is exploited to
      remove secular terms at each order.
    \end{itemize}
      
\end{frame}


\begin{frame}{Setup (continued)}
    \begin{itemize}
        \item Plugging into (P)

        \begin{align*}
        &\epsilon\left[\frac{\partial^2 \theta_0}{\partial t_0^2}
        + \epsilon^2\left(2\frac{\partial^2\theta_0}
        {\partial t_0 \partial t_1}\right)\right]
        +
        \epsilon^3\left[\frac{\partial^2 \theta_1}{\partial t_0^2}
        + \epsilon^2\left(2\frac{\partial^2\theta_1}
        {\partial t_0 \partial t_1}\right)\right] \\
        &\qquad
        +\epsilon\theta_0+\epsilon^3\theta_1
        -\frac16\left(\epsilon\theta_0+\epsilon^2\theta_1\right)^3
        =0,
        \\[1ex]
        &\epsilon\left(
        \theta_0+\frac{\partial^2\theta_0}{\partial t_0^2}
        \right)
        +\epsilon^3\left(
        \theta_1+\frac{\partial^2\theta_1}{\partial t_0^2}
        \right)
        +\epsilon^3\left(
        2\frac{\partial^2\theta_0}{\partial t_0\partial t_1}
        \right)
        \\
        &\qquad
        +\epsilon^4\left(
        2\frac{\partial^2\theta_1}{\partial t_0\partial t_1}
        \right)
        -\frac16\Bigl(
        \epsilon^3\theta_0^3
        +3\epsilon^4\theta_0^2\theta_1
        +2\epsilon^5\theta_0\theta_1^2
        +\epsilon^6\theta_1^3
        \Bigr)
        =0.
        \end{align*}
    \end{itemize}
    
\end{frame}


% ──────────────────────────────────────────────────────────────
\section{Leading-Order Solution}
% ──────────────────────────────────────────────────────────────
\begin{frame}{Order $\varepsilon$: Leading-Order Equation}\
    \begin{itemize}
        \item Collecting $O(\varepsilon)$ terms after substitution:
        \begin{equation}
            \frac{\partial^2 \theta_0}{\partial t_0^2} + \theta_0 = 0, \qquad
            \theta_0\big|_{t_0=t_1=0} = 1, \quad
            \frac{\partial \theta_0}{\partial t_0} \big|_{t_0=t_1=0} = 0. \tag{7}
        \end{equation}

        \medskip
        \item The general solution is:
        \begin{equation}
            \theta_0 = A(t_1)\cos t_0 + B(t_1)\sin t_0, \qquad
            A(0) = 1,\quad B(0) = 0, \tag{8}
        \end{equation}
        
        \medskip
        \item where $A$ and $B$ are \textit{functions of integration} to be
        determined at the next order.

        \medskip
        \item The slow-time dependence of $A$ and $B$ provides the extra freedom
        needed to absorb secular terms — this is the key mechanism of the method.        
    \end{itemize}
  
\end{frame}
% part iii


% ──────────────────────────────────────────────────────────────
\section{Solvability Condition}
% ──────────────────────────────────────────────────────────────


\begin{frame}{Order $\varepsilon^3$: Removing Secular Terms}
\begin{itemize}
    \item Collecting $O(\varepsilon^3)$ terms from the expanded substitution gives:
    \begin{equation}
    \frac{\partial^2 \theta_1}{\partial t_0^2}\, + \theta_1
    = 2\frac{dA}{dt_1}\sin t_0 - 2\frac{dB}{dt_1}\cos t_0
    + \frac{\theta_0^3}{6}=0 \tag{9}
    \end{equation}

    \medskip
    \item Expanding the right-hand side in $e^{\pm it_0}$ and $e^{\pm 3it_0}$,
    the coefficients of $e^{\pm it_0}$ are resonant with the
    left-hand side. These must vanish
    to prevent secular growth in $\theta_1$:
    \begin{block}{\textbf{Solvability Condition}}
        
    
    \begin{equation}
    0 = -\frac{dB}{dt_2} + i\frac{dA}{dt_2}
      + \frac{3}{48}[A - iB]^2[A + iB]. \tag{10}
    \end{equation}
    \end{block}

    \medskip
    i.e. the $e^{\pm it_0}$ term from the expanded right hand side on (5) must be zero.
  
    \smallskip
  

\end{itemize}
\end{frame}



\begin{frame}{Evolution Equations for $A$ and $B$}
\begin{itemize}
  \item Separating real and imaginary parts of (10) and using
  $[A-iB][A+iB] = A^2 + B^2$:
  \begin{equation}
    \frac{dB}{dt_1} = \frac{A(A^2 + B^2)}{16}, \qquad
    \frac{dA}{dt_1} = -\frac{B(A^2 + B^2)}{16}. \tag{11}
  \end{equation}

  \medskip
  \item Multiplying the first equation by $B$ and the second by $A$, then
  adding both together:
  \[
    \frac{1}{2}\frac{d}{dt_1}(A^2 + B^2) = 0 \qquad \Longrightarrow \qquad
    A^2 + B^2 = A^2(0) + B^2(0) = 1.  \tag{12} 
  \]
  
  \medskip
  \item Substituting $A^2 + B^2 = 1$ into (11) gives the simplified system:
  \begin{equation}
    \frac{dB}{dt_2} = \frac{A}{16}, \qquad
    \frac{dA}{dt_2} = -\frac{B}{16}, \qquad
    A(0) = 1,\; B(0) = 0. \tag{13}
  \end{equation}
  \item This is \textit{circular motion} in the $(A, B)$ plane.
\end{itemize}
\end{frame}

% ──────────────────────────────────────────────────────────────
\section{Solution}
% ──────────────────────────────────────────────────────────────

\begin{frame}{Solution for $A$, $B$ and $\theta_0$}
\begin{itemize}
  \item Solving (13) directly under the boundary conditions given:
      
  
  \begin{equation}
    A(t_1) = \cos\!\left(\frac{t_1}{16}\right), \qquad
    B(t_1) = \sin\!\left(\frac{t_1}{16}\right). \tag{14}
  \end{equation}

  \medskip
  \item Substituting back into (8) and using the cosine addition formula:
  \begin{equation}
  \theta_0(t) = \cos\!\left(t_0 - \frac{t_1}{16}\right)
               = \cos\!\left(t\Bigl(1 - \frac{\varepsilon^2}{16}\Bigr)\right)
  \tag{15}
  \end{equation}

  \medskip
  \begin{block}{Approximate period}
  \begin{equation}
    T = \frac{2\pi}{1 - \varepsilon^2/16}
      \approx 2\pi\!\left(1 + \frac{\varepsilon^2}{16}\right),
    \tag{16}
  \end{equation}
  \end{block}

\end{itemize}

\end{frame}


\begin{frame}{Temporal Interval of Validity}
\begin{itemize}
\begin{block}{Approximate solution }
  
  \[
    \theta \approx \varepsilon\,\theta_0 + \varepsilon^3\theta_1 + \cdots
  \]  
  
\end{block}
  

  \medskip
  \item The first order approximation $\theta_0$ remains valid as longs as its next order is incomparable to the first. $t_2$ time scale has eliminated the first order secular terms.
    \item The residual $\varepsilon^5\theta_2$ grows on the next slow timescale. To explain where this next residual growth comes from we need to consider higher order term in the expansion.
    \item By considering the symmetry of the pendulum equation which has terms 
    \[
    \sin(\varepsilon \theta) = \varepsilon\theta - \frac{{\varepsilon^3\theta}^3}{6} + \frac{\varepsilon^5\theta^5}{120} - \dots
    \]
    
 
  
\end{itemize}
\end{frame}

\begin{frame}{Continuing on Temporal Interval of Validity}

\begin{itemize}

    \item $\varepsilon^5$ term is next in line, which introduces a new resonance issues. To fix this, the even slower phase shift at $t_2 = \varepsilon^4 t$ has to be taken into account, which was ignored in our approximation.

    \[
    \varepsilon \theta_0 \sim \varepsilon^5 \theta_2 \qquad \Longrightarrow \qquad t \sim \varepsilon^{-4}.
  \]
  \item The multiple-scale structure then extends the validity, approximation breaks when:
  \[
    \boxed{t = O( \varepsilon^{-4})}
  \]
  after which the cumulative effect of the uncorrected, higher-order frequency shift catches up and the phase of the first order solution will have drifted by an O(1) amount compare to the true numerical solution, causing the approximation to break down. Still it is an improved approximate solution to the pendulum equation.
\end{itemize}
    
\end{frame}


