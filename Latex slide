\begin{frame}{Perturbation Methods}

Mathematical Models rarely have an explicit form.

\begin{itemize}
    \item Require approximations and numerical methods.
    \item Approximations often use perturbation methods:
    \begin{itemize}
        \item Equations have a very large or very small term.
        \item One physical process is significantly less important than another dominant process.
    \end{itemize}
    \item Problem is often rescaled with a small parameter, $\epsilon$.
    \item Use $\epsilon$ to create a 'Taylor-like' series expansion.
\end{itemize}

\end{frame}


\begin{frame}{Regular Perturbation}
\begin{itemize}
    \item Regular perturbation can be used for ODEs of the form:
    \[
F(t,y,y^\prime,y^{\prime\prime},\dots,y^{(n)},\epsilon)=0
\]
    \medskip
    \item where $F$ is some functional where $\epsilon$ doesn't multiply the highest derivative of $y$.

    \medskip
    \item e.g. Model in question,
\[
y^{\prime\prime}+y+\epsilon y^3=0
\]

\end{itemize}




\vspace{5mm}

\end{frame}


\begin{frame}{Regular Perturbation}
\begin{itemize}
    \item We assume a solution to the ODE of the form
\[
y(t)=y_0(t)+\epsilon y_1(t)+\epsilon^2 y_2(t)+\dots
\]
    \medskip
    \item where $y_0,y_1,\dots$ are found by substituting into the ODE.

    \medskip
    \item Each new term makes a more accurate approximation to the solution, but usually only a few terms are necessary.
\end{itemize}

\end{frame}


\begin{frame}{Leading Order Term}
\begin{itemize}
    \item We are trying to solve the following differential equation for $0<\epsilon \ll 1$:

    \begin{equation}\label{eq:1}
        y^{\prime\prime}+y+\epsilon y^3=0,\qquad y(0)=1, \qquad y^\prime(0)=0.
    \end{equation}
    
    \medskip
    \item Using the approximation $y\sim y_0+\epsilon y_1$ where we have ignored $\epsilon^2$ terms and higher.
    
    \medskip
    \item For $y_0$ term, take $\epsilon=0$, the unperturbed problem.
    \[
    y_0^{\prime\prime}+y_0=0 \implies y_0=A\cos{t} +B\sin{t}
    \]
    \[
    y(0)=1,\quad y^\prime(0)=0 \implies A=1,\ B=0 \implies y_0=\cos{t}
    \]
    \medskip
    \item So $y \sim \cos{t}+\epsilon y_1$
\end{itemize}

\end{frame}


\begin{frame}{Order $\epsilon$ Term}
\begin{itemize}
    \item In order to satisfy the initial conditions, $y(0)=1,\ y^\prime (0)=0$, we must have $y_1(0)=0$ and $y_1^\prime (0)=0$. Substituting our approximation into (\ref{eq:1}) gives

    \begin{equation*}
    \begin{split}
         y^{\prime\prime}+y+\epsilon y^3 & \sim -\cos{t} + \epsilon y_1^{\prime\prime} + \cos t +\epsilon y_1 + \epsilon(\cos t +\epsilon y_1)^3 \\
        & = \epsilon(y_1^{\prime\prime}+y_1) + \epsilon(\cos^3 t + 3\epsilon y_1\cos^2{t} + 3\epsilon^2 y_1^2\cos t + \epsilon^3 y_1^3) \\
        & = \epsilon(\cos^3 t + y_1^{\prime\prime} +y_1) + O(\epsilon^2) \\ 
        & = 0
    \end{split}
    \end{equation*}
    
    \medskip
    \item For the equation to be equal to 0, each power of $\epsilon$ has to be equal to 0 hence, 
    
    \[
        y_1^{\prime\prime}+y_1=-\cos^3
    t    
    \]
\end{itemize}
\end{frame}


\begin{frame}{Solving for $y_1$}
\begin{itemize}
    \item We can rewrite $\cos^3 t$ as $\cos^3 t = \frac{1}{4}\cos{3t}+\frac{3}{4}\cos{t}$ with the exponential definition of $\cos$ to get 
\begin{equation}\label{eq:2}
y_1^{\prime\prime}+y_1=-\frac{1}{4}\cos{3t} -\frac{3}{4}\cos{t}
\end{equation}

\medskip
\item (\ref{eq:2}) is an ordinary linear second order differential equation so we can solve it in the standard way. 

\[
y_h^{\prime\prime}+y_h=0 \implies y_h = A\cos{t}+ B\sin{t}
\]

\medskip
\item Now pick
\[
y_p = \alpha\cos{3t} + \beta t\sin{t} + \gamma t\cos{t}
\]
as our ansatz for the particular solution.

\end{itemize}

\end{frame}


\begin{frame}{Solving for $y_1$}
\begin{itemize}
    \item We have, 
\[
y_p^\prime = -3\alpha\sin{3t} + \beta t\cos{t} + \beta\sin{t} - \gamma t\sin{t} + \gamma\cos{t}
\]
\[
y_p^{\prime\prime} = -9\alpha\cos{3t} - \beta t\sin{t} + 2\beta\cos{t} - \gamma t\cos{t} -2\gamma\sin{t}
\]
\medskip 
\item And so
\begin{equation*}
\begin{split}
y_p^{\prime\prime}+y_p^{\prime} & = -9\alpha\cos{3t} - \beta t\sin{t}  + 2\beta\cos{t} - \gamma t\cos{t} -2\gamma\sin{t} \\
& \quad+\alpha\cos{3t} + \beta t\sin{t} + \gamma t\cos{t} \\
& = -8\alpha\cos{3t} +2\beta\cos{t} -2\gamma\sin{t} \\
& = -\frac{1}{4}\cos{3t} -\frac{3}{4}\cos{t}
\end{split}
\end{equation*}
\[
\implies \alpha = \frac{1}{32},\quad \beta = -\frac{3}{8},\quad \gamma = 0 
\]
\end{itemize}
\end{frame}


\begin{frame}{Solving for $y_1$}
\begin{itemize}
    \item \[
    \implies y_p = \frac{1}{32}\cos{3t} -\frac{3}{8}t\sin{t}
    \]
    \medskip \item So $y_1$ is given by,
    \[
    y_1 = y_h + y_p = A\cos{t}+ B\sin{t} + \frac{1}{32}\cos{3t} -\frac{3}{8}t\sin{t}
    \]
    \medskip \item Applying boundary conditions:
    \[
    y_1(0)=0,\quad y_1^\prime(0)=0,\quad \implies \quad A=-\frac{1}{32},\quad B=0
    \]
    
    \medskip \item Therefore, 
    \[
    y_1 = -\frac{1}{32}\cos{t} + \frac{1}{32}\cos{3t} -\frac{3}{8}t\sin{t}
    \]
\end{itemize}
\end{frame}


\begin{frame}{Approximation Solution}
\begin{itemize}
    \item Our complete approximation for y is therefore
\[
y\sim \cos{t} +\epsilon(-\frac{1}{32}\cos{t} + \frac{1}{32}\cos{3t} -\frac{3}{8}t\sin{t})
\]

\medskip \item Note the final term has a factor of t and is not just oscillatory. \break 
\medskip \item The term is called $secular$ as it blows up as $t\rightarrow \infty$.

\medskip \item In particular, when $t=O(\epsilon^{-1})$, the secular term $-\frac{3}{8}\epsilon t\sin{t}=O(1)$,\break 
and has the same order as the leading term and terms in the perturbation\break series have become disordered. This means that there is no longer an asymptotic expansion of the solution and the approximation breaks down.
\end{itemize}
\end{frame}


%part 1ii

\begin{frame}{Method of Multiple Scales}
\begin{itemize}
    \item The method of multiple scales (MMS) assumes that the solution $y(t)$ can be written as

\[
y(t) = y(t, \epsilon t, \epsilon^2 t, \cdots)
\]

    \item Using chain rule to differentiate the perturbation approximation and we can group the terms in the resulting equation by order of $\epsilon$.

    \item By eliminating secular terms in the resulting equation by enforcing appropriate solvability conditions, we can improve our approximation.
    
\end{itemize}
\end{frame}

\begin{frame}{Setup}
\begin{itemize}
    \item Let $t_0 = t$, $t_1 = \epsilon t$ and $y(t) \approx y_0(t_0,t_1)+\epsilon y_1(t_0,t_1) + O(\epsilon^2)$

\[
\frac{dy}{dt} = \frac{\partial y_0}{\partial t_0}+ \epsilon\frac{\partial y_0}{\partial t_1}+ \epsilon\frac{\partial y_1}{\partial t_0}+ O(\epsilon^2)
\]

\[
\frac{d^2y}{dt^2} = \frac{\partial^2 y_0}{\partial t_0 ^2} + \epsilon\frac{\partial^2 y_0}{\partial t_1 \partial t_0}+ \epsilon\frac{\partial^2 y_0}{\partial t_1 \partial t_0} + \epsilon\frac{\partial^2 y_1}{\partial t_0^2} + O(\epsilon^2)
\]

    \item Hence our equation $y'' + y + \epsilon y^3 = 0$ becomes
\end{itemize}
\begin{block}

\[
\underbrace{\frac{\partial^2 y_0}{\partial t_0 ^2}+y_0(t_0,t_1)}_{order 1} + \underbrace{\epsilon \left(2\frac{\partial^2 y_0}{\partial t_1 \partial t_0} + \frac{\partial^2 y_1}{\partial t^2} + y_1(t_0,t_1) + y_0^3(t_0,t_1)\right) }_{order \epsilon}+ O(\epsilon^2) = 0
\]

\end{block}
\end{frame}

\begin{frame}{Order 1: Leading Order Equation}
\begin{itemize}
    \item We solve the equation of zero order of $\epsilon$:

\[
O(1):\quad \frac{\partial^2 y_0}{\partial t_0 ^2}+y_0(t_0,t_1) = 0
\]

    \item Therefore $y_0(t_0,t_1) = A(t_1)e^{it_0}+B(t_1)e^{-it_0}$

    \item To determine $A(t_1)$ and $B(t_1)$, we use the equation of first order of $\epsilon$:

\[
O(\epsilon):\quad \frac{\partial^2 y_1}{\partial t_0^2} + y_1(t_0,t_1) = -2\frac{\partial^2 y_0}{\partial t_1 \partial t_0} - y_0^3(t_0,t_1) \qquad (*)
\]

where the homogeneous solution to $y_1(t_0,t_1)$ is the same as that of $y_0(t,t_1)$.

\item $-\text{RHS}(*) = A^3 e^{i3t_0} + B^3 e^{-i3t_0} + \left(2iA'(t_1) + 3A^2 B\right)e^{it_0} + \left(-2iB'(t_1) + 3A B^2\right)e^{-it_0}$

\end{itemize}
\end{frame}

\begin{frame}{Order $\epsilon$: Removing Secular Terms  and Solvability Condition}
\begin{itemize}
    \item $-\text{RHS}(*) = A^3 e^{i3t_0} + B^3 e^{-i3t_0} + \left(2iA'(t_1) + 3A^2 B\right)e^{it_0} + \left(-2iB'(t_1) + 3A B^2\right)e^{-it_0}$

    \item The $e^{it_0}$ and $e^{-it_0}$ term forces the particular solution to become secular.

    Therefore we enforce that these two terms are zero:

\[
2iA'(t_1) + 3A^2 B = 0 \quad (a)
\]
\[
-2iB'(t_1) + 3A B^2 = 0 \quad (b)
\]

    (a) and (b) are called the solvability condition.

\[
B \cdot (a) - A \cdot (b) = 0 \quad \Longrightarrow \quad \frac{d}{dt_1}(AB) = 0
\]

    \item Thus $AB = c$ for some constant $c$

\[
aiA' + 3cA = 0 \quad \Longrightarrow \quad A(t_1) = k \cdot \exp\!\left(i \frac{3c}{2}t_1\right),\quad B(t_1) = \frac{c}{k} \cdot \exp\!\left(-i\frac{3c}{2}t_1\right)
\]

\end{itemize}
\end{frame}

\begin{frame}{Solution for A and B}
\begin{itemize}
    \item[] \begin{equation*}
            y_0(t_0,t_1) = k \cdot \exp\!\left(i \frac{3c}{2}t_1 + it_0\right) + \frac{c}{k} \cdot \exp\!\left(-i\frac{3c}{2}t_1 - it_0\right)
            \end{equation*}
    \item Using boundary condition:
    \item[] \begin{equation*}
            y(0) = 1 \quad \Longrightarrow \quad k + \frac{c}{k} = 1
            \end{equation*}
    \item[] \begin{equation*}
            y'(0) = 0 \quad \Longrightarrow \quad \left(i \frac{3c}{2} \epsilon + i\right)k + \frac{c}{k}\left(-i\frac{3c}{2} \epsilon - i\right) = 0
            \end{equation*}
    \item Hence $k = \frac{1}{2}$, $c = \frac{1}{4}$ and
    \item[]\begin{equation*}
            y_0(t_0,t_1) = \frac{1}{2}\exp\!\left(i\left(1+\frac{3}{8}\epsilon\right)t_0\right) + \frac{1}{2}\exp\!\left(-i\left(1+\frac{3}{8}\epsilon\right)t_0\right) = \cos\!\left(\left(1+\frac{3}{8}\epsilon\right)t\right)
            \end{equation*}
    \item Therefore $y(t) = \cos\!\left(\left(1+\frac{3}{8}\epsilon\right)t\right) + O(\epsilon)$ as required.
\end{itemize}
\end{frame}

\begin{frame}{Approximate Period and Temporal Interval of Validity}\
\begin{itemize}
    \item The approximate period of $y$ is thus $T = 2\pi(1+\frac{3}{8}\epsilon)^{-1}$

    \item Since we removed the secular term in $y_1(t_0,t_1)$, this solution is valid for time up to $t = O(\epsilon^{-2})$, where the secular term of order $O(\epsilon^2)$ becomes $O(1)$ and our approximation breaks.
\end{itemize}

